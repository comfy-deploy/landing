---
// "How it works": steps 1–2 are shared by every product page; later steps come in via <slot />.
import { Image } from 'astro:assets';
import nodesShot from '../assets/step-custom-nodes.png';
import assetsShot from '../assets/step-upload-assets.png';
import gpuShot from '../assets/step-select-gpu.png';
import migrateShot from '../assets/step-migrate-workflow.png';

const setup = [
  {
    t: 'Select custom nodes',
    d: 'Pick a ComfyUI version, then add custom nodes from the community list or any Git URL. Every dependency is version-locked, so your team gets a reproducible runtime.',
    img: nodesShot,
    alt: 'Choosing a ComfyUI version and custom nodes in ComfyDeploy',
  },
  {
    t: 'Upload your assets',
    d: 'Upload models, LoRAs, and files to a shared team workspace. Sync straight from Hugging Face, Civitai, a URL, or your local machine.',
    img: assetsShot,
    alt: 'Uploading models and LoRAs to a shared ComfyDeploy workspace',
  },
  {
    t: 'Select a GPU and deploy',
    d: 'Choose a dedicated GPU like an A100 or H100, or enable auto-scaling. Set workflow timeout, warm time, and max parallel GPUs, then launch.',
    img: gpuShot,
    alt: 'Selecting a GPU and machine settings in ComfyDeploy',
  },
];
---

<section class="section how">
  <div class="wrap">
    <div class="intro">
      <p class="muted">How it works</p>
      <h2>From local workflow to team collaboration</h2>
    </div>

    <ol class="steps">
      <li>
        <h3><span>1</span>Choose or create your ComfyUI setup</h3>
        <div class="three">
          {
            setup.map((s) => (
              <div class="item">
                <div class="img">
                  <Image src={s.img} alt={s.alt} widths={[400, 700]} sizes="(max-width: 800px) 100vw, 360px" />
                </div>
                <h4>{s.t}</h4>
                <p>{s.d}</p>
              </div>
            ))
          }
        </div>
      </li>
      <li>
        <h3><span>2</span>Create or upload your workflow</h3>
        <div class="paths">
          <div>
            <h4>Start fresh in ComfyDeploy</h4>
            <ul>
              <li><strong>Instant launch.</strong> A new ComfyUI environment, ready in your browser.</li>
              <li><strong>Full node access.</strong> The complete editor with any custom nodes you need.</li>
              <li><strong>Pro hardware.</strong> Build on A100 and H100 GPUs from day one.</li>
            </ul>
          </div>
          <p class="or" aria-hidden="true">or</p>
          <div>
            <h4>Migrate your existing ComfyUI workflow</h4>
            <ul>
              <li><strong>Quick integration.</strong> Add ComfyDeploy nodes to your local ComfyUI.</li>
              <li><strong>One-click deploy.</strong> Push workflows straight to our cloud platform.</li>
              <li><strong>Perfect replication.</strong> Models, nodes, and settings transfer intact.</li>
            </ul>
          </div>
        </div>
        <div class="shot wide">
          <Image src={migrateShot} alt="A ComfyUI workflow open in the ComfyDeploy cloud editor" widths={[640, 1100, 1600]} sizes="(max-width: 1180px) 100vw, 1000px" />
        </div>
      </li>
      <slot />
    </ol>
  </div>
</section>

<style>
  .how {
    background: var(--bg-2);
  }
  .intro {
    max-width: 40rem;
    margin-bottom: clamp(48px, 7vw, 80px);
  }
  .intro p {
    margin-bottom: 12px;
    font-weight: 500;
  }
  .intro h2 {
    font-size: var(--step-3);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(64px, 9vw, 120px);
  }
  .steps :global(> li > h3) {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: var(--step-2);
    margin-bottom: 36px;
  }
  .steps :global(> li > h3 > span) {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 12px;
    background: var(--ink);
    color: var(--bg);
    font: 500 16px var(--mono);
    letter-spacing: 0;
  }
  .three {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .img {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg);
    overflow: hidden;
    margin-bottom: 20px;
  }
  .img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .item:hover .img img {
    transform: scale(1.04);
  }
  .steps :global(h4) {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin-bottom: 8px;
  }
  .item p {
    color: var(--ink-3);
    font-size: 0.9688rem;
  }
  .paths {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 32px;
    align-items: start;
    margin-bottom: 40px;
  }
  .paths ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
    color: var(--ink-3);
  }
  .paths strong {
    color: var(--ink);
    font-weight: 500;
  }
  .or {
    align-self: center;
    font: 14px var(--mono);
    color: var(--ink-3);
  }
  @media (max-width: 800px) {
    .three,
    .paths {
      grid-template-columns: 1fr;
    }
    .or {
      justify-self: start;
    }
  }
</style>
