---
// Most-viewed templates as an internal-link block for the home and product pages.
import WorkflowCard from './WorkflowCard.astro';
import { getWorkflows } from '../../lib/workflows';

interface Props {
  title?: string;
}
const { title = 'Start from a ready-made workflow' } = Astro.props;
const all = await getWorkflows();
const top = [...all].sort((a, b) => b.views - a.views).slice(0, 6);
---

<section class="section">
  <div class="wrap">
    <div class="row">
      <div class="head">
        <h2>{title}</h2>
        <p class="lede">{all.length} free ComfyUI templates for Flux, Qwen-Image, Wan 2.2 and more. Open one and run it on a cloud GPU in a click.</p>
      </div>
      <a class="btn btn-ghost" href="/workflows">Browse all workflows</a>
    </div>
    <ul>
      {top.map((w) => <li><WorkflowCard w={w} headingLevel="h3" /></li>)}
    </ul>
  </div>
</section>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .row .head {
    margin-bottom: 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: clamp(16px, 2vw, 24px);
  }
  li {
    display: flex;
  }
  li > :global(*) {
    flex: 1;
  }
</style>
