---
import { Image } from 'astro:assets';
import { TASK_LABEL, type Workflow } from '../../lib/workflows';

interface Props {
  w: Workflow;
  eager?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { w, eager = false, headingLevel: H = 'h2' } = Astro.props;
const task = w.tasks[0] ? TASK_LABEL[w.tasks[0]] : null;
---

<article class="card">
  <a href={`/workflows/${w.slug}`} class="media" tabindex="-1" aria-hidden="true">
    {w.poster ? (
      <Image src={w.poster} alt="" widths={[360, 560, 760]} sizes="(min-width: 1180px) 360px, (min-width: 700px) 45vw, 100vw" loading={eager ? 'eager' : 'lazy'} />
    ) : (
      <span class="ph">{w.family}</span>
    )}
    {w.video && <span class="badge">Video</span>}
  </a>
  <div class="body">
    <p class="meta"><span class="fam">{w.family === 'Other' ? 'Workflow' : w.family}</span>{task && <span> · {task}</span>}</p>
    <H class="t"><a href={`/workflows/${w.slug}`}>{w.title}</a></H>
    {w.gpu && <p class="gpu">{w.gpu === 'CPU' ? 'No GPU needed' : w.gpu}</p>}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 4px);
    background: var(--bg);
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }
  .card:hover {
    border-color: var(--ink-3);
    transform: translateY(-2px);
  }
  .media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--bg-2);
    overflow: hidden;
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card:hover .media :global(img) {
    transform: scale(1.035);
  }
  .ph {
    display: grid;
    place-items: center;
    height: 100%;
    font: 14px var(--mono);
    color: var(--ink-3);
  }
  .badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    border-radius: 999px;
    background: #09090bcc;
    color: #fff;
    font-size: 12px;
    font-weight: 500;
    backdrop-filter: blur(6px);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px 20px;
    flex: 1;
  }
  .meta {
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  .fam {
    color: var(--accent);
    font-weight: 500;
  }
  .t {
    font-size: 1.1875rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
    font-weight: 600;
    text-wrap: pretty;
  }
  .t a {
    text-decoration: none;
  }
  /* whole card clickable, keeping one real link for crawlers and screen readers */
  .t a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card:hover .t a {
    color: var(--accent);
  }
  .gpu {
    margin-top: auto;
    padding-top: 6px;
    font: 13px var(--mono);
    color: var(--ink-3);
  }
</style>
