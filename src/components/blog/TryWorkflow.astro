---
// "Try this workflow" card for blog posts. The workflow JSON lives in public/workflow-files/ (CORS-enabled in
// vercel.json) so the app can import it straight from the URL: app.comfydeploy.com/workflows?view=import&workflow_json=…
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../../consts';

interface Props {
  title: string;
  /** Path under public/, e.g. "/workflow-files/flux3-klein-t2i.json". */
  file: string;
  image: ImageMetadata;
  model: string;
  /** Suggested GPU class, e.g. "L40S (48 GB)". */
  gpu?: string;
  /** Who made the workflow, e.g. "ComfyUI official template (MIT)". */
  source: string;
  sourceHref?: string;
}
const { title, file, image, model, gpu, source, sourceHref } = Astro.props;
const runUrl = `https://app.comfydeploy.com/workflows?view=import&workflow_json=${encodeURIComponent(new URL(file, SITE.url).href)}`;
---

<section class="try" aria-label={`Try the ${title} workflow`}>
  <div class="shot">
    <Image src={image} alt={`Sample output from the ${title} workflow`} widths={[480, 760]} sizes="(min-width: 800px) 340px, 100vw" />
  </div>
  <div class="body">
    <p class="kicker">Try this workflow</p>
    <h3>{title}</h3>
    <dl>
      <div><dt>Model</dt><dd>{model}</dd></div>
      {gpu && <div><dt>GPU</dt><dd>{gpu}</dd></div>}
      <div><dt>Source</dt><dd>{sourceHref ? <a href={sourceHref} target="_blank" rel="noopener">{source}</a> : source}</dd></div>
    </dl>
    <div class="actions">
      <a class="btn btn-primary btn-sm" href={runUrl}>Run on ComfyDeploy</a>
      <a class="btn btn-ghost btn-sm" href={file} download>Download JSON</a>
    </div>
  </div>
</section>

<style>
  .try {
    display: grid;
    gap: 0;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 4px);
    background: var(--bg-2);
    overflow: hidden;
  }
  .shot {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 0;
    border-radius: 0;
  }
  .body {
    padding: 22px 24px 24px;
  }
  .kicker {
    margin: 0;
    font-size: 0.875rem;
    color: var(--accent);
    font-weight: 500;
  }
  h3 {
    margin: 4px 0 0;
    font-size: var(--step-1);
    line-height: 1.2;
    color: var(--ink);
  }
  dl {
    display: grid;
    gap: 6px;
    margin: 16px 0 0;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  dl div {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 12px;
  }
  dt {
    color: var(--ink-3);
  }
  dd {
    margin: 0;
    color: var(--ink);
  }
  dd a {
    color: inherit;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }
  .actions a.btn {
    text-decoration: none;
  }
  .actions a.btn-primary {
    color: var(--bg);
  }
  .actions a.btn-primary:hover {
    color: #fff;
  }
  .actions a.btn-ghost {
    color: var(--ink);
  }
  @media (min-width: 760px) {
    .try {
      grid-template-columns: 300px 1fr;
    }
    .shot {
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .body {
      align-self: center;
    }
  }
</style>
