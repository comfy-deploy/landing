---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import WorkflowCard from '../../components/workflows/WorkflowCard.astro';
import { SITE } from '../../consts';
import { faqJsonLd } from '../../lib/schema';
import { getWorkflows, slugify, TASK_LABEL } from '../../lib/workflows';

export async function getStaticPaths() {
  const all = await getWorkflows();
  return all.map((w) => {
    // Related: same model family first, then shared task, then newest.
    const score = (o: typeof w) => (o.family === w.family && w.family !== 'Other' ? 2 : 0) + (o.tasks.some((t) => w.tasks.includes(t)) ? 1 : 0);
    const related = all
      .filter((o) => o.slug !== w.slug)
      .map((o) => ({ o, s: score(o) }))
      .sort((a, b) => b.s - a.s)
      .slice(0, 3)
      .map(({ o }) => o);
    return { params: { slug: w.slug }, props: { w, related } };
  });
}

const { w, related } = Astro.props;
const { Content } = w.entry ? await render(w.entry) : { Content: null };
const url = `${SITE.url}/workflows/${w.slug}`;
const abs = (p: string) => new URL(p, SITE.url).href;
const og = w.poster ? abs((await getImage({ src: w.poster, width: 1200, format: 'jpg' })).src) : undefined;
const famHref = w.family !== 'Other' ? `/workflows/model/${slugify(w.family)}` : '/workflows';
const famName = w.family !== 'Other' ? w.family : 'All workflows';
const gpuLabel = w.gpu === 'CPU' ? 'No GPU (runs on CPU)' : w.gpu;

const specs: [string, string[] | string | null][] = [
  ['Recommended GPU', gpuLabel],
  ['You provide', w.inputs],
  ['You get', w.outputs],
  ['Models', w.models],
  ['Custom nodes', w.packages.length ? w.packages : w.nodeCount ? ['ComfyUI core nodes only'] : []],
  ['Graph', w.nodeCount ? `${w.nodeCount} nodes${w.comfyui ? ` · ComfyUI ${w.comfyui}` : ''}` : null],
];

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: w.title,
    headline: w.seoTitle,
    description: w.description,
    url,
    ...(og && { image: og }),
    programmingLanguage: 'ComfyUI workflow (JSON)',
    runtimePlatform: 'ComfyUI',
    codeSampleType: 'template',
    keywords: [w.family, ...w.tasks.map((t) => TASK_LABEL[t]), 'ComfyUI workflow'].filter((k) => k !== 'Other').join(', '),
    dateCreated: w.created.toISOString(),
    dateModified: w.updated.toISOString(),
    isAccessibleForFree: true,
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon.png` } },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Workflows', item: `${SITE.url}/workflows` },
      ...(w.family !== 'Other' ? [{ '@type': 'ListItem', position: 3, name: w.family, item: SITE.url + famHref }] : []),
      { '@type': 'ListItem', position: w.family !== 'Other' ? 4 : 3, name: w.title, item: url },
    ],
  },
  ...(w.faq.length ? [faqJsonLd(w.faq)] : []),
  ...(w.video && og
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'VideoObject',
          name: `${w.title}: example output`,
          description: w.description,
          thumbnailUrl: og,
          contentUrl: w.video,
          uploadDate: w.created.toISOString(),
        },
      ]
    : []),
];
---

<Base title={`${w.seoTitle} | ${SITE.name}`} description={w.description} image={og} jsonLd={jsonLd}>
  <article>
    <header class="wrap hero">
      <div class="intro">
        <nav aria-label="Breadcrumb" class="crumbs">
          <a href="/workflows">Workflows</a>
          {w.family !== 'Other' && <><span aria-hidden="true">/</span><a href={famHref}>{w.family}</a></>}
        </nav>
        <h1>{w.title}</h1>
        <p class="lede">{w.summary}</p>
        <div class="ctas">
          <a class="btn btn-primary" href={w.runUrl}>Run on ComfyDeploy</a>
          <a class="btn btn-ghost" href={w.downloadUrl} download>Download JSON</a>
        </div>
        <ul class="facts">
          {w.gpu && <li>{gpuLabel}</li>}
          {w.tasks.map((t) => <li><a href={`/workflows/task/${t}`}>{TASK_LABEL[t]}</a></li>)}
          <li>Free template</li>
        </ul>
      </div>
      <figure class="shot media">
        {w.video ? (
          <video
            data-autoplay
            src={w.video}
            poster={og}
            muted
            loop
            playsinline
            controls
            preload="none"
            width={w.poster?.width}
            height={w.poster?.height}
            aria-label={`${w.title} example output`}></video>
        ) : (
          w.poster && (
            <Image src={w.poster} alt={`${w.title} example output`} widths={[560, 900, 1200]} sizes="(min-width: 1180px) 560px, (min-width: 900px) 48vw, 100vw" loading="eager" fetchpriority="high" />
          )
        )}
      </figure>
    </header>

    <div class="wrap detail">
      <div class="prose">
        {Content && <Content />}
        {
          w.useCases.length > 0 && (
            <>
              <h2>What you can use it for</h2>
              <ul class="uses">
                {w.useCases.map((u) => (
                  <li>{u}</li>
                ))}
              </ul>
            </>
          )
        }
      </div>
      <aside class="specs" aria-label="What's inside">
        <h2>What's inside</h2>
        <dl>
          {
            specs
              .filter(([, v]) => v && (!Array.isArray(v) || v.length))
              .map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>
                    {Array.isArray(v) ? (
                      <ul class={k === 'Models' || k === 'Custom nodes' ? 'mono' : ''}>
                        {v.map((x) => (
                          <li>{x}</li>
                        ))}
                      </ul>
                    ) : (
                      v
                    )}
                  </dd>
                </div>
              ))
          }
        </dl>
        <a class="btn btn-primary btn-sm full" href={w.runUrl}>Open in ComfyDeploy</a>
      </aside>
    </div>

    <section class="wrap steps" aria-labelledby="steps-h">
      <h2 id="steps-h">Run it in three steps</h2>
      <ol>
        <li>
          <h3>Open the template</h3>
          <p>Click Run on ComfyDeploy. The workflow, its custom nodes and models are set up for you on a cloud machine.</p>
        </li>
        <li>
          <h3>Add your inputs</h3>
          <p>{w.inputs.length ? `Provide ${w.inputs.slice(0, 2).join(' and ').toLowerCase()} in the playground or the ComfyUI editor.` : 'Set your inputs in the playground or the ComfyUI editor.'}</p>
        </li>
        <li>
          <h3>Run, share or deploy</h3>
          <p>Run it on {w.gpu && w.gpu !== 'CPU' ? `${/^[AEFHILMNORSX]/.test(w.gpu) ? 'an' : 'a'} ${w.gpu}` : 'a cloud machine'}, share it with your team as a playground, or deploy it as an API endpoint.</p>
        </li>
      </ol>
    </section>

    {w.faq.length > 0 && <Faq items={w.faq} />}

    <section class="wrap more" aria-labelledby="more-h">
      <div class="more-head">
        <h2 id="more-h">Related workflows</h2>
        <a href={famHref}>{famName === 'All workflows' ? 'All workflows' : `All ${famName} workflows`}</a>
      </div>
      <ul>
        {related.map((r) => <li><WorkflowCard w={r} headingLevel="h3" /></li>)}
      </ul>
    </section>
  </article>
</Base>

<script>
  // Play example videos only when visible, and never for reduced-motion or data-saver users (preload="none" otherwise).
  const vids = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches || (navigator as any).connection?.saveData;
  if (!still && vids.length) {
    const io = new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? (e.target as HTMLVideoElement).play().catch(() => {}) : (e.target as HTMLVideoElement).pause())), { threshold: 0.3 });
    vids.forEach((v) => io.observe(v));
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding-block: clamp(40px, 7vw, 88px) clamp(48px, 7vw, 96px);
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: var(--step--1);
    color: var(--ink-3);
    margin-bottom: 20px;
  }
  .crumbs a {
    color: var(--ink-3);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--ink);
  }
  h1 {
    font-size: var(--step-3);
  }
  .intro .lede {
    margin-top: 20px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
  }
  .facts li {
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--ink-2);
    background: var(--bg);
  }
  .facts a {
    text-decoration: none;
  }
  .facts a:hover {
    color: var(--accent);
  }
  .media {
    margin: 0;
  }
  .media video,
  .media :global(img) {
    width: 100%;
    border-radius: var(--radius);
    background: var(--bg-2);
  }

  .detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
    padding-block: clamp(48px, 7vw, 88px);
    border-top: 1px solid var(--line);
  }
  .prose {
    max-width: 68ch;
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--ink-2);
    overflow-wrap: break-word;
  }
  .prose > :global(* + *) {
    margin-top: 1.2em;
  }
  .prose :global(h2) {
    font-size: var(--step-2);
    color: var(--ink);
    line-height: 1.15;
    margin-top: 2em;
  }
  .prose > :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--accent);
    text-underline-offset: 3px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4em;
  }
  .prose :global(li + li) {
    margin-top: 0.5em;
  }
  .prose :global(li::marker) {
    color: var(--ink-3);
  }
  .prose :global(:not(pre) > code) {
    font-size: 0.86em;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.1em 0.4em;
    overflow-wrap: anywhere;
  }
  .uses {
    list-style: none;
    padding: 0 !important;
  }
  .uses li {
    position: relative;
    padding-left: 30px;
  }
  .uses li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.55em;
    width: 14px;
    height: 8px;
    border-left: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    transform: rotate(-45deg);
  }

  .specs {
    position: sticky;
    top: 88px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 4px);
    background: var(--bg-2);
  }
  .specs h2 {
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }
  .specs dl {
    margin: 16px 0 20px;
  }
  .specs dl > div {
    padding-block: 12px;
    border-top: 1px solid var(--line);
  }
  .specs dt {
    font-size: 0.8125rem;
    color: var(--ink-3);
    margin-bottom: 4px;
  }
  .specs dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink);
  }
  .specs ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .specs ul li + li {
    margin-top: 2px;
  }
  .specs ul.mono {
    font: 12.5px/1.5 var(--mono);
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  .full {
    width: 100%;
  }

  .steps {
    padding-block: clamp(56px, 8vw, 104px);
    border-top: 1px solid var(--line);
  }
  .steps h2 {
    font-size: var(--step-3);
    max-width: 12em;
  }
  .steps ol {
    list-style: none;
    counter-reset: s;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 48px);
    margin: clamp(32px, 5vw, 56px) 0 0;
    padding: 0;
  }
  .steps li {
    counter-increment: s;
    padding-top: 20px;
    border-top: 1px solid var(--ink);
  }
  .steps li::before {
    content: counter(s);
    display: block;
    font: 14px var(--mono);
    color: var(--accent);
    margin-bottom: 14px;
  }
  .steps h3 {
    font-size: var(--step-1);
    letter-spacing: -0.02em;
  }
  .steps p {
    margin-top: 10px;
    color: var(--ink-2);
  }

  .more {
    padding-block: clamp(48px, 7vw, 96px) clamp(80px, 12vw, 140px);
    border-top: 1px solid var(--line);
  }
  .more-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 32px;
  }
  .more h2 {
    font-size: var(--step-2);
  }
  .more-head a {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .more-head a:hover {
    text-decoration: underline;
  }
  .more ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
  }
  .more li {
    display: flex;
  }
  .more li > :global(*) {
    flex: 1;
  }

  @media (max-width: 900px) {
    .hero,
    .detail {
      grid-template-columns: 1fr;
    }
    .specs {
      position: static;
    }
    .steps ol,
    .more ul {
      grid-template-columns: 1fr;
    }
  }
</style>
