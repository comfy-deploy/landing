---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | ComfyDeploy" description="This page doesn’t exist. Head back to ComfyDeploy." noindex>
  <section class="section wrap nf">
    <p class="muted">404</p>
    <h1>This page doesn’t exist.</h1>
    <p class="lede">It may have moved when we rebuilt the site. Try the homepage or the blog.</p>
    <div class="ctas">
      <a class="btn btn-primary" href="/">Go to homepage</a>
      <a class="btn btn-ghost" href="/blog">Read the blog</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 18px;
  }
  h1 {
    font-size: var(--step-4);
  }
  .ctas {
    display: flex;
    gap: 12px;
    margin-top: 12px;
  }
</style>
