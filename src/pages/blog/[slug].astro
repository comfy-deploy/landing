---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, more: [...posts.slice(i + 1), ...posts.slice(0, i)].slice(0, 3) },
  }));
}

const { post, more } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, category, cover } = post.data;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const ogSrc = cover ? (await getImage({ src: cover, width: 1200, format: 'png' })).src : undefined;
const url = `${SITE.url}/blog/${post.id}`;
const abs = (p: string) => new URL(p, SITE.url).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    ...(ogSrc && { image: abs(ogSrc) }),
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon.png` } },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---

<Base title={`${title} | ${SITE.name}`} description={description} type="article" image={ogSrc} jsonLd={jsonLd}>
  <article class="post">
    <header class="wrap head">
      <nav aria-label="Breadcrumb" class="crumbs"><a href="/blog">Blog</a></nav>
      <p class="meta"><span class="cat">{category}</span> · <time datetime={date.toISOString()}>{fmt(date)}</time></p>
      <h1>{title}</h1>
    </header>

    {cover && (
      <div class="wrap cover">
        <Image src={cover} alt="" widths={[640, 1024, 1400]} sizes="(min-width: 1180px) 1100px, 100vw" loading="eager" fetchpriority="high" />
      </div>
    )}

    <div class="wrap">
      <div class="prose"><Content /></div>
    </div>
  </article>

  <aside class="wrap more" aria-labelledby="more-h">
    <h2 id="more-h">More from the blog</h2>
    <ul>
      {more.map((p) => (
        <li>
          <p class="meta"><span class="cat">{p.data.category}</span> · <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time></p>
          <h3><a href={`/blog/${p.id}`}>{p.data.title}</a></h3>
        </li>
      ))}
    </ul>
  </aside>
</Base>

<style>
  .head { padding-top: clamp(48px, 8vw, 104px); max-width: calc(68ch + var(--gutter) * 2 + 120px); }
  .crumbs { font-size: var(--step--1); margin-bottom: 32px; }
  .crumbs a { color: var(--ink-3); text-decoration: none; }
  .crumbs a:hover { color: var(--ink); }
  .crumbs a::before { content: '← '; }
  .meta { font-size: var(--step--1); color: var(--ink-3); margin-bottom: 16px; }
  .cat { color: var(--accent); font-weight: 500; }
  h1 { font-size: var(--step-3); line-height: 1.08; }
  .cover { margin-top: clamp(32px, 5vw, 64px); max-width: 1000px; }
  .cover img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: calc(var(--radius) + 4px); border: 1px solid var(--line); }
  .prose { margin-top: clamp(40px, 6vw, 72px); padding-bottom: clamp(64px, 9vw, 120px); }

  .more { padding-block: clamp(48px, 7vw, 96px) clamp(80px, 12vw, 140px); border-top: 1px solid var(--line); }
  .more h2 { font-size: var(--step-2); margin-bottom: 40px; }
  .more ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 40px; }
  .more h3 { font-size: var(--step-1); line-height: 1.2; }
  .more h3 a { text-decoration: none; }
  .more h3 a:hover { color: var(--accent); }
  @media (min-width: 800px) { .more ul { grid-template-columns: repeat(3, 1fr); gap: 56px; } }
</style>

<style is:global>
  .prose { max-width: 68ch; margin-inline: auto; font-size: 1.125rem; line-height: 1.7; color: var(--ink-2); overflow-wrap: break-word; }
  .prose > * + * { margin-top: 1.4em; }
  .prose h2 { font-size: var(--step-2); color: var(--ink); margin-top: 2.4em; line-height: 1.15; }
  .prose h3 { font-size: var(--step-1); color: var(--ink); margin-top: 2em; line-height: 1.2; }
  .prose h4 { font-size: 1.125rem; color: var(--ink); margin-top: 1.8em; }
  .prose strong { color: var(--ink); font-weight: 600; }
  .prose a { color: var(--accent); text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .prose a:hover { text-decoration-thickness: 2px; }
  .prose ul, .prose ol { padding-left: 1.4em; }
  .prose li + li { margin-top: 0.5em; }
  .prose li > ul, .prose li > ol { margin-top: 0.5em; }
  .prose li::marker { color: var(--ink-3); }
  .prose img, .prose video { border-radius: var(--radius); border: 1px solid var(--line); margin-inline: auto; }
  .prose p > img + img { margin-top: 1em; }
  .prose blockquote { margin-inline: 0; padding-left: 1.2em; border-left: 3px solid var(--line); color: var(--ink-3); }
  .prose blockquote > * + * { margin-top: 0.8em; }
  .prose hr { border: 0; border-top: 1px solid var(--line); margin-block: 2.5em; }
  .prose :not(pre) > code { font-size: 0.88em; background: var(--bg-2); border: 1px solid var(--line); border-radius: 6px; padding: 0.1em 0.4em; overflow-wrap: anywhere; }
  .prose pre { font-size: 0.875rem; line-height: 1.6; padding: 18px 20px; border-radius: var(--radius); border: 1px solid var(--line); overflow-x: auto; }
  .prose pre code { font-family: var(--mono); }
  .prose table { display: block; overflow-x: auto; border-collapse: collapse; width: 100%; font-size: 1rem; }
  .prose th, .prose td { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .prose th { color: var(--ink); font-weight: 600; }
  .prose iframe { width: 100%; aspect-ratio: 16 / 9; height: auto; border: 0; border-radius: var(--radius); }

  /* shiki dual themes: switch to dark vars under [data-theme='dark'] */
  [data-theme='dark'] .astro-code,
  [data-theme='dark'] .astro-code span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
  }
</style>
