---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, LINKS } from '../consts';
import outfitWoff2 from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
}

const { title, description, image = '/og.png', type = 'website', jsonLd, noindex } = Astro.props;
// build.format 'file' makes pathname end in .html in prod builds; canonical must be the clean URL
const cleanPath = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/favicon.png`,
  sameAs: [LINKS.x, LINKS.github, LINKS.discord],
};
const ld = [org, ...(jsonLd ? [jsonLd].flat() : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={outfitWoff2} as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="ComfyDeploy Blog" href="/rss.xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Hover spotlight for feature rows: one passive listener, writes a CSS var. No layout work.
      for (const el of document.querySelectorAll<HTMLElement>('[data-spotlight]')) {
        el.addEventListener(
          'pointermove',
          (e) => {
            const kids = [...(el.children as HTMLCollectionOf<HTMLElement>)];
            const lefts = kids.map((c) => c.getBoundingClientRect().left); // read all, then write
            kids.forEach((c, i) => c.style.setProperty('--x', `${e.clientX - lefts[i]}px`));
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>
