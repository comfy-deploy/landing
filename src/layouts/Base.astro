---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, LINKS } from '../consts';
import outfitWoff2 from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
  /** Send signed-in app users straight to app.comfydeploy.com (homepage only, like the Framer site did). */
  authRedirect?: boolean;
}

const { title, description, image = '/og.png', type = 'website', jsonLd, noindex, authRedirect } = Astro.props;
// build.format 'file' makes pathname end in .html in prod builds; canonical must be the clean URL
const cleanPath = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/favicon.png`,
  sameAs: [LINKS.x, LINKS.github, LINKS.discord],
};
const ld = [org, ...(jsonLd ? [jsonLd].flat() : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {
      authRedirect && (
        <script is:inline>
          // Clerk sets __client_uat_<suffix> on .comfydeploy.com: a unix timestamp when signed in, 0 when signed out.
          // Only the prod instance's cookie counts (suffix = sha1(pk_live_…) base64url[0:8]); staging/dev instances
          // leave their own stale cookies on the same domain. Framer loaded the whole Clerk SDK (~1.8MB) for this. ?stay skips it.
          if (/(?:^|;\s*)__client_uat_Qu0VI-qD=[1-9]/.test(document.cookie) && !/[?&]stay\b/.test(location.search))
            location.replace('https://app.comfydeploy.com/');
        </script>
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Analytics />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={outfitWoff2} as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="ComfyDeploy Blog" href="/rss.xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Analytics carried over from Framer (GA4 G-WKBYQS1J3Q, Google Ads AW-17197205183, Dub outbound for cal.com).
      // Loaded after window load + idle so it never competes with first paint.
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-WKBYQS1J3Q');
      gtag('config', 'AW-17197205183');
      addEventListener('load', () =>
        (window.requestIdleCallback || setTimeout)(() => {
          const add = (src, attrs = {}) => {
            const s = document.createElement('script');
            s.src = src;
            s.async = true;
            for (const k in attrs) s.setAttribute(k, attrs[k]);
            document.head.append(s);
          };
          add('https://www.googletagmanager.com/gtag/js?id=G-WKBYQS1J3Q');
          add('https://www.dubcdn.com/analytics/script.js', { 'data-domains': '{"outbound":"app.cal.com"}' });
        }),
      );
    </script>
    <script>
      // Hover spotlight for feature rows: one passive listener, writes a CSS var. No layout work.
      for (const el of document.querySelectorAll<HTMLElement>('[data-spotlight]')) {
        el.addEventListener(
          'pointermove',
          (e) => {
            const kids = [...(el.children as HTMLCollectionOf<HTMLElement>)];
            const lefts = kids.map((c) => c.getBoundingClientRect().left); // read all, then write
            kids.forEach((c, i) => c.style.setProperty('--x', `${e.clientX - lefts[i]}px`));
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>
